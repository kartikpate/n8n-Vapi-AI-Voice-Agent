    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"received\" }",
        "options": {
          "responseCode": 200
        }
      },
      "id": "83d59ea8-95c5-4afe-8bf0-554f6bd09e3f",
      "name": "Acknowledge End of Call",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        208,
        368
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\n// Get original Vapi message\nconst message =\n  data.rawPayload?.body?.message ||\n  data.body?.message ||\n  data.message ||\n  {};\n\n// Try all common Vapi tool-call locations\nconst toolCalls =\n  (Array.isArray(data.toolCalls) && data.toolCalls.length > 0\n    ? data.toolCalls\n    : null) ||\n  message.toolCallList ||\n  message.toolCalls ||\n  [];\n\nconst firstTool = toolCalls[0] || {};\n\n// Get function information\nconst fn = firstTool.function || {};\n\n// Tool name\nlet toolName =\n  fn.name ||\n  firstTool.name ||\n  message.toolWithToolCallList?.[0]?.toolCall?.function?.name ||\n  message.toolWithToolCallList?.[0]?.name ||\n  'unknown';\n\n// Tool arguments\nlet toolArgs =\n  fn.arguments ??\n  firstTool.arguments ??\n  firstTool.parameters ??\n  message.toolWithToolCallList?.[0]?.toolCall?.function?.parameters ??\n  {};\n\nif (typeof toolArgs === 'string') {\n  try {\n    toolArgs = JSON.parse(toolArgs);\n  } catch (e) {\n    toolArgs = {};\n  }\n}\n\n// Tool call ID\nconst toolCallId =\n  firstTool.id ||\n  firstTool.toolCallId ||\n  message.toolWithToolCallList?.[0]?.toolCall?.id ||\n  'unknown';\n\nreturn {\n  toolName,\n  toolArgs,\n  toolCallId\n};"
      },
      "id": "01420d95-6769-4c5a-851f-14232ba0114c",
      "name": "Extract Tool Call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        624
      ]
    },
    {
      "parameters": {
        "jsCode": "const availabilityData = $input.first().json;\n\n// Get original tool call information\nconst toolData = $('Extract Tool Call').first().json;\n\nconst toolCallId = toolData.toolCallId;\nconst date = toolData.toolArgs.date;\nconst time = toolData.toolArgs.time;\n\nconst available = availabilityData.available === true;\n\nlet result;\n\nif (available) {\n  result = `The requested appointment time ${time} on ${date} is available. Would you like me to book it?`;\n} else {\n  result = `The requested appointment time ${time} on ${date} is not available. Please choose another time.`;\n}\n\nreturn {\n  toolCallId,\n  result\n};"
      },
      "id": "b51e5509-86b2-44e2-bf7a-1303e5d2833b",
      "name": "Check Calendar Availability",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        496
      ]
    },
    {
      "parameters": {
        "jsCode": "const toolData = $('Extract Tool Call').first().json;\n\nconst toolCallId = toolData.toolCallId;\nconst args = toolData.toolArgs;\n\nconst date = args.date;\nconst time = args.time;\nconst name = args.name || 'Caller';\n\nreturn {\n  toolCallId,\n  result: `Your appointment has been successfully booked for ${date} at ${time} for ${name}.`\n};"
      },
      "id": "c5df1348-5e80-4036-884b-2bafe7dc851b",
      "name": "Book Appointment Tool",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1488,
        704
      ]
    },
    {
      "parameters": {
        "jsCode": "const toolData = $('Extract Tool Call').first().json;\n\nconst args = toolData.toolArgs || {};\n\nconst name = args.name || 'Unknown';\nconst phone =\n  args.phone ||\n  $('Parse Incoming Data').first().json.callerNumber ||\n  'Unknown';\n\nconst email = args.email || '';\nconst message =\n  args.message ||\n  args.note ||\n  args.reason ||\n  'No message provided';\n\nreturn {\n  toolCallId: toolData.toolCallId,\n  callerName: name,\n  callerPhone: phone,\n  callerEmail: email,\n  callerMessage: message,\n  callId: $('Parse Incoming Data').first().json.callId || '',\n  receivedAt: new Date().toISOString()\n};"
      },
      "id": "1414d240-f681-4f3a-95ee-6cb197123fc4",
      "name": "Take Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
