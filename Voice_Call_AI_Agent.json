{
  "name": "AI Voice Agent - GitHub Safe",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-call-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "20859522-f9a7-4ce4-ae41-6be16af3163b",
      "name": "Call Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -656,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "// Safely extract message type from either payload structure\nconst body = $input.first().json;\n\n// Handle both wrapped and unwrapped payloads\nconst message = body.body?.message || body.message || {};\nconst call = message.call || {};\nconst customer = call.customer || {};\nconst artifact = message.artifact || {};\nconst messages = artifact.messages || [];\n\nreturn {\n  messageType: message.type || 'unknown',\n  callId: call.id || 'unknown',\n  callerNumber: customer.number || 'unknown',\n  callType: call.type || 'unknown',\n  messages: messages,\n  lastUserMessage: messages.filter(m => m.role === 'user').pop()?.content || '',\n  toolCalls: message.toolCalls || [],\n  transcript: artifact.transcript || '',\n  summary: artifact.summary || '',\n  durationSeconds: message.durationSeconds || 0,\n  endedReason: message.endedReason || '',\n  rawPayload: body\n};"
      },
      "id": "4e1cd8f5-3174-4e7e-b8b3-9bb40d5a72be",
      "name": "Parse Incoming Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract the AI response text safely\nconst openAiOutput = $input.first().json;\n\n// Get content from OpenAI response\nlet content = '';\n\nif (openAiOutput.message?.content) {\n  content = openAiOutput.message.content;\n} else if (openAiOutput.choices?.[0]?.message?.content) {\n  content = openAiOutput.choices[0].message.content;\n} else if (typeof openAiOutput.content === 'string') {\n  content = openAiOutput.content;\n} else {\n  content = 'Thank you for calling. How can I help you today?';\n}\n\nreturn {\n  responseText: content,\n  fullResponse: openAiOutput\n};"
      },
      "id": "956052c1-9158-4982-a90a-a37b4490b3ad",
      "name": "Extract AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"messageResponse\": {\n    \"role\": \"assistant\",\n    \"content\": {{ JSON.stringify($json.responseText) }}\n  }\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "5edd029c-77cc-48f7-8768-9f4c43fca1d2",
      "name": "Respond to VAPI",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        864,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const openAiOutput = $input.first().json;\n\n// Try multiple common locations for the model response\nlet content =\n  openAiOutput.message?.content ||\n  openAiOutput.choices?.[0]?.message?.content ||\n  openAiOutput.output_text ||\n  openAiOutput.text ||\n  openAiOutput.output?.[0]?.content?.[0]?.text ||\n  '{}';\n\n// If content is not already a string\nif (typeof content !== 'string') {\n  content = JSON.stringify(content);\n}\n\nlet analysis;\n\ntry {\n  const cleaned = content\n    .replace(/```json\\s*/gi, '')\n    .replace(/```\\s*/g, '')\n    .trim();\n\n  analysis = JSON.parse(cleaned);\n} catch (e) {\n  analysis = {\n    callerName: 'Unknown',\n    intent: 'other',\n    summary: content,\n    appointmentRequested: false,\n    appointmentDate: null,\n    appointmentTime: null,\n    actionRequired: 'Manual review needed',\n    sentiment: 'neutral',\n    urgency: 'low'\n  };\n}\n\n// Bring back the original call information\nconst callData = $('Parse Incoming Data').first().json;\n\n// Normalize important fields\nanalysis.appointmentRequested =\n  analysis.appointmentRequested === true ||\n  analysis.appointmentRequested === 'true';\n\nreturn {\n  ...callData,\n  ...analysis,\n  processedAt: new Date().toISOString()\n};"
      },
      "id": "d508f0ff-3567-426b-a7ea-426645db22c8",
      "name": "Parse AI Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        208
      ]
    },
    {
      "parameters": {
